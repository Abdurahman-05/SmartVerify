{
  "expo": {
    "name": "ገብቷል",
    "slug": "smartVerify",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smartverify",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.gebtual.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F8F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "ገብቷል uses the camera to scan customers' payment QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#0D4A36"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95b55aec-d9a3-460a-92ec-c3486c711060"
      }
    },
    "owner": "abdu-sala"
  }
}
