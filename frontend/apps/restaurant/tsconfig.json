{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "../../src/*"
      ],
      "@/assets/*": [
        "../../assets/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../src/**/*.ts",
    "../../src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../nativewind-env.d.ts",
    "app.config.ts",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
