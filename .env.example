# Backend API base URL (including /api/v1). Optional in development: when empty, the app uses the IP of
# the computer running Metro + :3000, which works for a phone on the same Wi-Fi and for emulators.
# Examples:
#   Physical phone (same Wi-Fi):  EXPO_PUBLIC_API_URL=http://192.168.1.20:3000/api/v1   (your PC's Wi-Fi IP, see `ipconfig`)
#   Android emulator:             EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api/v1
#   iOS simulator / web:          EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# Only public values go here: EXPO_PUBLIC_* variables are bundled into the app. Never put secrets in this file.
EXPO_PUBLIC_API_URL=

# App Configuration
EXPO_PUBLIC_APP_ENV=development
