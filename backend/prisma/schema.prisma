// Smart Verify database schema — built from the app contract in docs/BACKEND.md.
//
// Rules
// - Money is integer ETB (Int). Never floats.
// - Timestamps are UTC. Ids are opaque cuid strings.
// - Phones are 9 digits without +251 ("912345678"); customer phones are 10 digits ("0912345678").
// - History is never cascade-deleted: bank accounts are soft-removed, businesses are deactivated.
// - Constraints Prisma cannot express (partial unique indexes, CHECKs) are added in the migration SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum Role {
  owner
  manager
  waiter
  chef
}

enum Plan {
  normal
  restaurant
}

enum BillingPeriod {
  monthly
  quarterly
}

enum SubscriptionStatus {
  active
  cancelled
  expired
}

enum TransactionStatus {
  verified
  pending
  mismatch
  duplicate
}

/// Why a verification did not pass. Codes only; the app translates them.
enum TransactionReason {
  nameMismatch
  amountMismatch
  duplicate
}

enum MenuCategory {
  food
  drinks
  combos
}

enum BillType {
  dine
  takeaway
  delivery
}

enum BillStatus {
  open
  paid
}

enum ServedStatus {
  kitchen
  served
}

enum OrderNote {
  noOnion
  lessSpicy
  rush
  takeaway
}

enum PaymentMethod {
  bank
  cash_bank @map("cash+bank")
  cash
}

enum TipSource {
  bank
  cash
}

/// A receipt check that did not verify.
enum ReceiptCheckStatus {
  not_matching
  unable_to_verify
}

enum KitchenStatus {
  new
  cooking
  ready
}

// ─── Identity & access ─────────────────────────────────────────────────────

/// A person who can sign in. Phone is globally unique because sign-in is phone + PIN only.
model User {
  id             String   @id @default(cuid())
  name           String
  /// 9 digits without +251.
  phone          String   @unique
  /// Argon2id hash. Never returned by the API.
  pinHash        String
  /// True for a temporary staff PIN set by the owner/manager.
  pinIsTemporary Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ownedBusiness Business?       @relation("BusinessOwner")
  /// v1: one business per person.
  membership    BusinessMember?
  sessions      Session[]
}

model Business {
  id              String    @id @default(cuid())
  name            String
  ownerId         String    @unique
  owner           User      @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /// null = exploring without a plan.
  plan            Plan?
  packingFeeEtb   Int       @default(30)
  /// Day boundaries for "today" and reports.
  timezone        String    @default("Africa/Addis_Ababa")
  /// Next human order number (#1001, #1002, …), incremented inside the order transaction.
  nextOrderNumber Int       @default(1001)
  deactivatedAt   DateTime?
  /// Profile the owner fills in (shown to the Smart Verify admin).
  businessType    String?
  city            String?
  address         String?
  latitude        Float?
  longitude       Float?
  locationSetAt   DateTime?
  /// Admin: suspended by hand (only sign-in and the pay page work).
  suspendedAt     DateTime?
  /// Admin: never restricted for late payment (partner, special case).
  exemptFromRules Boolean   @default(false)
  exemptReason    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members         BusinessMember[]
  adminNotes      AdminNote[]
  paymentReviews  PaymentReview[]
  subscriptions   Subscription[]
  bankAccounts    BankAccount[]
  transactions    Transaction[]
  menuItems       MenuItem[]
  itemCategories  ItemCategory[]
  tableCategories TableCategory[]
  tables          RestaurantTable[]
  deliveryAreas   DeliveryArea[]
  bills           Bill[]
  orders          Order[]
  payments        Payment[]
  tips            Tip[]
  kitchenOrders   KitchenOrder[]
  paymentScans    BillPaymentScan[]
  receiptChecks   ReceiptCheck[]
}

/// A person's role inside a business. The owner also has a member row (role = owner).
model BusinessMember {
  id                   String          @id @default(cuid())
  businessId           String
  business             Business        @relation(fields: [businessId], references: [id], onDelete: Restrict)
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  role                 Role
  /// Inactive staff cannot sign in.
  active               Boolean         @default(true)
  canChangeDeliveryFee Boolean         @default(false)
  canSeeReports        Boolean         @default(false)
  createdById          String?
  createdBy            BusinessMember? @relation("MemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  created            BusinessMember[]  @relation("MemberCreatedBy")
  sessions           Session[]
  transactions       Transaction[]
  billsServed        Bill[]            @relation("BillWaiter")
  deliveryFeeChanges Bill[]            @relation("BillDeliveryFeeChangedBy")
  ordersTaken        Order[]
  paymentsRecorded   Payment[]         @relation("PaymentRecordedBy")
  tips               Tip[]
  paymentScans       BillPaymentScan[]
  receiptChecks      ReceiptCheck[]

  @@index([businessId])
}

/// Server-side session behind every token. Sign-out sets revokedAt, which invalidates the token at once.
model Session {
  id        String         @id @default(cuid())
  /// SHA-256 of the bearer token. The token itself is never stored.
  tokenHash String         @unique
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId  String
  member    BusinessMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime       @default(now())

  @@index([userId])
}

model Subscription {
  id               String             @id @default(cuid())
  businessId       String
  business         Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan             Plan
  /// Restaurant Plus is always monthly.
  period           BillingPeriod
  priceEtb         Int
  status           SubscriptionStatus @default(active)
  startedAt        DateTime
  endsAt           DateTime
  /// Idempotency-Key of the "choose plan" request, so a retry does not start a second subscription.
  idempotencyKey   String?
  /// Reference of the CBE receipt that paid for it; one receipt pays once.
  paymentReference String?            @unique
  /// cbe | telebirr | manual (admin) | trial | free (development)
  paymentMethod    String?
  /// Admin's note when started or extended by hand.
  note             String?
  createdAt        DateTime           @default(now())

  @@unique([businessId, idempotencyKey])
  @@index([businessId, status])
}

// ─── Banks & payment verification ──────────────────────────────────────────

/// Supported banks and wallets (CBE, Telebirr, Awash, …). Managed as data, not code.
model Bank {
  code      String  @id
  name      String
  shortName String
  active    Boolean @default(true)
  sortOrder Int     @default(0)

  accounts BankAccount[]
}

/// A receiving account of the business. Max 6 active per business (checked in the service).
model BankAccount {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  bankCode      String
  bank          Bank      @relation(fields: [bankCode], references: [code], onDelete: Restrict)
  /// Full number (8–16 digits; Telebirr: the 10-digit phone). The API only returns last4.
  accountNumber String
  last4         String
  /// From the user, or looked up at the bank. null until known.
  holderName    String?
  /// Soft delete: removed accounts keep their transactions and still show in reports.
  removedAt     DateTime?
  createdAt     DateTime  @default(now())

  transactions Transaction[]
  // + partial unique (businessId, bankCode, accountNumber) WHERE removedAt IS NULL (migration SQL)

  @@index([businessId])
}

/// One verification attempt, shown in History and Reports. Only `verified` rows count as money.
/// Restaurant bank checks also create a row, linked to the bill.
model Transaction {
  id             String             @id @default(cuid())
  businessId     String
  business       Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  /// Not known for receipts checked by link or number (the bank's receipt names the receiver).
  bankAccountId  String?
  bankAccount    BankAccount?       @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)
  /// Copied from the account so duplicate checks work per bank.
  bankCode       String
  /// Who scanned it.
  memberId       String
  member         BusinessMember     @relation(fields: [memberId], references: [id], onDelete: Restrict)
  /// Set when the scan paid a restaurant bill.
  billId         String?
  bill           Bill?              @relation(fields: [billId], references: [id], onDelete: Restrict)
  /// Bank reference, e.g. "FT1234567890". null while pending without one.
  reference      String?
  payerName      String?
  /// Name registered on the receiving account at the bank (for nameMismatch).
  registeredName String?
  expectedAmount Int
  receivedAmount Int                @default(0)
  status         TransactionStatus
  reason         TransactionReason?
  /// For duplicates: the first verified transaction with this reference.
  duplicateOfId  String?
  duplicateOf    Transaction?       @relation("DuplicateOf", fields: [duplicateOfId], references: [id], onDelete: Restrict)
  duplicates     Transaction[]      @relation("DuplicateOf")
  verifiedAt     DateTime?
  idempotencyKey String?
  createdAt      DateTime           @default(now())
  // + partial unique (bankCode, reference) WHERE status = 'verified' (migration SQL):
  //   a bank reference can be verified only once, across all businesses.

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
  @@index([businessId, bankAccountId, createdAt])
  @@index([billId])
}

// ─── Restaurant Plus ───────────────────────────────────────────────────────

model MenuItem {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name           String
  priceEtb       Int
  /// Kind of the item's category (food, drinks, combos): what starter packs and price tools use.
  category       MenuCategory
  /// The category the owner or manager put it in (e.g. "Hot drinks"). Shown to users.
  categoryId     String
  itemCategory   ItemCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  active         Boolean      @default(true)
  sortOrder      Int          @default(0)
  /// Amharic name shown when the app is in Amharic (optional).
  nameAm         String?
  /// Key of the starter-pack item it was imported from (src/modules/menu/catalog/).
  catalogKey     String?
  /// Section shown to users, e.g. "Meat & Tibs" (from the starter pack, or set by hand).
  groupName      String?
  /// Soft delete: hidden everywhere; past orders keep their own copy of name and price.
  deletedAt      DateTime?
  /// Idempotency-Key of the "add item" request, so a retried add does not create a duplicate.
  idempotencyKey String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  // + partial unique (businessId, catalogKey) WHERE catalogKey IS NOT NULL AND deletedAt IS NULL
  // + partial unique (businessId, name ignoring case and spaces) WHERE deletedAt IS NULL   (migration SQL)

  @@unique([businessId, idempotencyKey])
  @@index([businessId, active])
  @@index([categoryId])
}

/// A menu category made by the owner or manager ("Hot drinks", "Fast food", "Combos"…).
model ItemCategory {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  /// Amharic name shown when the app is in Amharic (optional).
  nameAm     String?
  /// Starter packs add their items to the first category of the matching kind.
  kind       MenuCategory @default(food)
  sortOrder  Int          @default(0)
  /// Soft delete (only an empty category can be deleted).
  deletedAt  DateTime?
  createdAt  DateTime     @default(now())

  items MenuItem[]
  // + partial unique (businessId, name ignoring case and spaces) WHERE deletedAt IS NULL   (migration SQL)

  @@index([businessId])
}

/// A group of tables made by the owner or manager ("Main floor", "VIP", "Garden"…).
model TableCategory {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name       String
  /// Amharic name shown when the app is in Amharic (optional).
  nameAm     String?
  sortOrder  Int       @default(0)
  /// Soft delete (only a category without tables in use can be deleted).
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  tables RestaurantTable[]
  // + partial unique (businessId, name ignoring case and spaces) WHERE deletedAt IS NULL   (migration SQL)

  @@index([businessId])
}

model RestaurantTable {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  number     Int
  categoryId String
  category   TableCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  active     Boolean       @default(true)

  bills Bill[]

  @@unique([businessId, categoryId, number])
  @@index([categoryId])
}

model DeliveryArea {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  name        String
  usualFeeEtb Int
  active      Boolean  @default(true)

  bills Bill[]

  @@unique([businessId, name])
}

/// The check for one table / takeaway / delivery. Created with the first order; later orders
/// ("Add more items") attach to the same open bill.
model Bill {
  id                     String           @id @default(cuid())
  businessId             String
  business               Business         @relation(fields: [businessId], references: [id], onDelete: Restrict)
  type                   BillType
  // Dine in
  tableId                String?
  table                  RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: Restrict)
  guests                 Int?
  // Takeaway / delivery
  customerName           String?
  /// 10 digits, e.g. "0912345678".
  customerPhone          String?
  deliveryAreaId         String?
  deliveryArea           DeliveryArea?    @relation(fields: [deliveryAreaId], references: [id], onDelete: Restrict)
  address                String?
  /// Area's usual fee at order time, and who changed it when the fee differs.
  usualDeliveryFeeEtb    Int?
  deliveryFeeChangedById String?
  deliveryFeeChangedBy   BusinessMember?  @relation("BillDeliveryFeeChangedBy", fields: [deliveryFeeChangedById], references: [id], onDelete: Restrict)
  // Money (server-calculated)
  foodTotalEtb           Int
  packingFeeEtb          Int              @default(0)
  deliveryFeeEtb         Int              @default(0)
  /// foodTotal + packingFee + deliveryFee (DB CHECK).
  totalEtb               Int
  /// Bank money received so far across scans (a short payment keeps the bill open).
  bankReceivedEtb        Int              @default(0)
  /// The bill's waiter: receives the tips.
  waiterId               String
  waiter                 BusinessMember   @relation("BillWaiter", fields: [waiterId], references: [id], onDelete: Restrict)
  status                 BillStatus       @default(open)
  servedStatus           ServedStatus     @default(kitchen)
  paidAt                 DateTime?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  orders        Order[]
  transactions  Transaction[]
  payment       Payment?
  paymentScans  BillPaymentScan[]
  tips          Tip[]
  receiptChecks ReceiptCheck[]
  // + partial unique (tableId) WHERE status = 'open' AND type = 'dine' (one open bill per table)

  @@index([businessId, status, createdAt])
  @@index([businessId, waiterId, status])
}

/// One send to the kitchen. The first order creates the bill.
model Order {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  billId         String
  bill           Bill           @relation(fields: [billId], references: [id], onDelete: Restrict)
  /// Human number per business (#1043).
  number         Int
  notes          OrderNote[]
  waiterId       String
  waiter         BusinessMember @relation(fields: [waiterId], references: [id], onDelete: Restrict)
  foodTotalEtb   Int
  idempotencyKey String?
  createdAt      DateTime       @default(now())

  items        OrderItem[]
  kitchenOrder KitchenOrder?

  @@unique([businessId, number])
  @@unique([businessId, idempotencyKey])
  @@index([billId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  menuItemId String?
  /// Name and price are copied so later menu changes do not alter past orders.
  name       String
  priceEtb   Int
  quantity   Int

  @@index([orderId])
}

/// What the chef sees: one per order. `ready` also marks the bill served.
model KitchenOrder {
  id         String        @id @default(cuid())
  businessId String
  business   Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  orderId    String        @unique
  order      Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  status     KitchenStatus @default(new)
  startedAt  DateTime?
  readyAt    DateTime?
  createdAt  DateTime      @default(now())

  @@index([businessId, status, createdAt])
}

/// The settlement of a bill (one per bill, created when it becomes paid).
/// One bank scan towards a bill. A short scan keeps the bill open; the next scan adds to it.
/// Until bank verification exists, amountEtb is what the app's (fake) bank check reported.
model BillPaymentScan {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  billId         String
  bill           Bill           @relation(fields: [billId], references: [id], onDelete: Restrict)
  memberId       String
  member         BusinessMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  amountEtb      Int
  /// Cash part of a cash+bank payment at the time of this scan.
  cashEtb        Int            @default(0)
  reference      String?
  idempotencyKey String
  createdAt      DateTime       @default(now())

  @@unique([businessId, idempotencyKey])
  @@index([billId])
}

model Payment {
  id             String         @id @default(cuid())
  businessId     String
  business       Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  billId         String         @unique
  bill           Bill           @relation(fields: [billId], references: [id], onDelete: Restrict)
  method         PaymentMethod
  cashEtb        Int            @default(0)
  /// Total bank money across all scans.
  bankEtb        Int            @default(0)
  tipEtb         Int            @default(0)
  /// Cash given back to the customer (cash only, extraChoice = giveback).
  changeEtb      Int            @default(0)
  recordedById   String
  recordedBy     BusinessMember @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  idempotencyKey String?
  createdAt      DateTime       @default(now())

  tip Tip?

  @@unique([businessId, idempotencyKey])
  @@index([businessId, createdAt])
}

/// Extra money kept by the bill's waiter. Never counted as sales.
model Tip {
  id         String         @id @default(cuid())
  businessId String
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Restrict)
  billId     String
  bill       Bill           @relation(fields: [billId], references: [id], onDelete: Restrict)
  paymentId  String         @unique
  payment    Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amountEtb  Int
  source     TipSource
  waiterId   String
  waiter     BusinessMember @relation(fields: [waiterId], references: [id], onDelete: Restrict)
  paidOut    Boolean        @default(false)
  paidOutAt  DateTime?
  createdAt  DateTime       @default(now())

  @@index([businessId, waiterId, createdAt])
}

/// A bank receipt check that did not verify (not matching, or the bank could not be read).
/// Kept so failed tries show in history. Verified checks become payments instead.
model ReceiptCheck {
  id                String             @id @default(cuid())
  businessId        String
  business          Business           @relation(fields: [businessId], references: [id], onDelete: Restrict)
  checkedById       String
  checkedBy         BusinessMember     @relation(fields: [checkedById], references: [id], onDelete: Restrict)
  /// The bill being paid, when the check came from a bill.
  billId            String?
  bill              Bill?              @relation(fields: [billId], references: [id], onDelete: Restrict)
  bankCode          String
  status            ReceiptCheckStatus
  /// not_matching: WRONG_RECEIVER | AMOUNT_TOO_LOW | NOT_SUCCESS | EXPIRED;
  /// unable_to_verify: one of TIMEOUT | UNREACHABLE | NOT_FOUND | UNPARSEABLE.
  reasons           String[]
  /// From the receipt, when it could be read.
  reference         String?
  receiptAmountEtb  Int?
  expectedAmountEtb Int
  createdAt         DateTime           @default(now())

  @@index([businessId, createdAt])
}

// ─── Platform admin (the Smart Verify team, not businesses) ─────────────────

enum AdminRole {
  super_admin
}

/// A member of the Smart Verify team. Separate from business users: never part of a business.
model AdminUser {
  id                 String            @id @default(cuid())
  email              String            @unique
  name               String
  role               AdminRole         @default(super_admin)
  /// Argon2id hash. The password itself is never stored.
  passwordHash       String
  /// Authenticator secret, AES-256-GCM encrypted with ADMIN_SECRET_KEY. Null until set up.
  totpSecretEnc      String?
  totpEnabledAt      DateTime?
  /// Last accepted 30-second step, so a code cannot be used twice.
  totpLastStep       Int?
  failedSignIns      Int               @default(0)
  lockedUntil        DateTime?
  /// Signed out after this many minutes without activity (30, 120 or 480).
  idleTimeoutMinutes Int               @default(120)
  active             Boolean           @default(true)
  lastSignInAt       DateTime?
  createdAt          DateTime          @default(now())
  sessions           AdminSession[]
  backupCodes        AdminBackupCode[]
  activity           AdminActivity[]
  notes              AdminNote[]
  decidedReviews     PaymentReview[]
  announcements      Announcement[]
}

/// One-time backup codes for two-step sign-in. Only SHA-256 hashes are stored.
model AdminBackupCode {
  id        String    @id @default(cuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
}

enum AdminSessionStage {
  /// Password accepted; the two-step code (or its first setup) is still needed.
  password
  /// Fully signed in.
  full
}

/// Server-side admin session. Only the SHA-256 of its token is stored.
model AdminSession {
  id         String            @id @default(cuid())
  tokenHash  String            @unique
  adminId    String
  admin      AdminUser         @relation(fields: [adminId], references: [id], onDelete: Cascade)
  stage      AdminSessionStage
  lastSeenAt DateTime          @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  ip         String?
  createdAt  DateTime          @default(now())

  @@index([adminId])
}

/// Every admin action and sign-in. Append-only: there is no route to edit or delete it.
model AdminActivity {
  id         String     @id @default(cuid())
  /// Null for a sign-in try with an unknown email.
  adminId    String?
  admin      AdminUser? @relation(fields: [adminId], references: [id], onDelete: Restrict)
  /// money | customers | rules | sign_in | private_data
  category   String
  /// e.g. signed_in, sign_in_failed, two_step_enabled, viewed_location
  action     String
  businessId String?
  /// Before/after values and other facts. Never PINs, passwords, tokens or codes.
  details    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([category, createdAt])
}

/// Private notes from the Smart Verify team about one business.
model AdminNote {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)
  text       String
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
}

enum PaymentReviewStatus {
  pending
  approved
  rejected
  asked_rest
}

/// A plan-payment receipt the server could not decide alone (amount low, bank site down, ...).
model PaymentReview {
  id          String              @id @default(cuid())
  businessId  String
  business    Business            @relation(fields: [businessId], references: [id], onDelete: Restrict)
  plan        Plan
  period      BillingPeriod
  expectedEtb Int
  /// CBE | TEL
  bankCode    String
  /// The receipt link (CBE) or transaction number (telebirr): one review per receipt.
  receiptKey  String
  reference   String?
  paidEtb     Int?
  payerName   String?
  receiptDate DateTime?
  /// not_matching reasons, or the unable_to_verify reason.
  reasons     String[]
  status      PaymentReviewStatus @default(pending)
  note        String?
  decidedById String?
  decidedBy   AdminUser?          @relation(fields: [decidedById], references: [id], onDelete: Restrict)
  decidedAt   DateTime?
  createdAt   DateTime            @default(now())

  @@unique([businessId, receiptKey])
  @@index([status, createdAt])
}

/// The admin's rules and prices (one row, id 1).
model PlatformSettings {
  id                     Int      @id @default(1)
  trialEnabled           Boolean  @default(true)
  trialDays              Int      @default(14)
  reminderDays           Int[]    @default([7, 3, 1])
  graceDays              Int      @default(3)
  restrictedDays         Int      @default(7)
  /// What Restricted blocks: receipt_checks | orders | reports | staff
  restrictedBlocks       String[] @default(["receipt_checks", "orders", "reports", "staff"])
  priceNormalMonthly     Int      @default(700)
  priceNormalQuarterly   Int      @default(1500)
  priceRestaurantMonthly Int      @default(4000)
  updatedAt              DateTime @updatedAt
}

/// Server problems grouped by cause: one row per kind, counted.
model ErrorLog {
  id         String    @id @default(cuid())
  key        String    @unique
  /// receipt_check | read_picture | database | server
  area       String
  /// Short machine cause, e.g. bank_timeout:DAS, gemini_rate_limit, db_unreachable, error:TypeError
  cause      String
  route      String?
  count      Int       @default(1)
  firstSeen  DateTime  @default(now())
  lastSeen   DateTime  @default(now())
  resolvedAt DateTime?
}

/// Daily counters (Gemini calls, rate-limit hits, Tesseract fallbacks, ...).
model DailyCounter {
  day   String
  key   String
  count Int    @default(0)

  @@id([day, key])
}

/// A banner shown in the business app.
model Announcement {
  id          String    @id @default(cuid())
  bodyEn      String
  bodyAm      String
  /// all | plan | city
  audience    String    @default("all")
  plan        Plan?
  city        String?
  showFrom    DateTime
  hideOn      DateTime
  createdById String
  createdBy   AdminUser @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())

  @@index([showFrom, hideOn])
}
