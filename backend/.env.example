# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Local Docker database (docker compose up -d db). Host port 5433.
DATABASE_URL=postgresql://smartverify:smartverify_dev_password@localhost:5433/smartverify?schema=public
# Used by `npm test` only. Created automatically by docker/init-test-db.sql.
TEST_DATABASE_URL=postgresql://smartverify:smartverify_dev_password@localhost:5433/smartverify_test?schema=public

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Token lifetime: normal sign-in, and with "Remember me".
SESSION_TTL_HOURS=12
SESSION_REMEMBER_TTL_DAYS=30

# Comma-separated browser origins allowed by CORS (Expo web dev server). Native apps do not need CORS.
CORS_ORIGINS=http://localhost:8081

# Business day boundaries for "today" / reports.
BUSINESS_TIMEZONE=Africa/Addis_Ababa

# Development only: start subscriptions without payment (payment provider not integrated yet). Must be false in production.
ALLOW_UNPAID_SUBSCRIPTIONS=true

# Abuse limits (per IP). Sign-in is limited per IP + phone.
SIGN_IN_MAX_ATTEMPTS=5
SIGN_IN_WINDOW_MINUTES=15
REGISTER_MAX_PER_HOUR=10
