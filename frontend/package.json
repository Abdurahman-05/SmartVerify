{
  "name": "gebtual-frontend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "start": "npm run start --workspace apps/restaurant",
    "dev": "npm run start --workspace apps/restaurant",
    "start:restaurant": "npm run start --workspace apps/restaurant",
    "start:shop": "npm run start --workspace apps/shop",
    "start:normal": "npm run start --workspace apps/shop",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"apps/*/src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-native": "^5.0.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3"
  }
}
