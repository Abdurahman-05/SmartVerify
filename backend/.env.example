# Copy to .env. Never commit real values.
DATABASE_URL=
ADMIN_SECRET_KEY=

# Public Terms and Privacy pages (GET /terms, /privacy)
COMPANY_NAME=Gebtual Tech Solution
SUPPORT_EMAIL=support@gebtual.com.et
# One number, or several separated by commas
SUPPORT_PHONE=+251829277776, +25178287776

# Email for sign-up codes
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=Gebtual <no-reply@gebtual.com.et>

# Telegram support bot (@gebtual_support_bot). Token from @BotFather; chat id of the team group
# (add the bot to it); secret: any 16+ random letters/digits. Then: npm run support-bot:webhook -- <https url>
SUPPORT_BOT_TOKEN=
SUPPORT_CHAT_ID=
SUPPORT_WEBHOOK_SECRET=
